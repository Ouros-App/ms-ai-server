APP_PORT=8000
# Leave all four bootstrap fields empty to run without Infisical locally.
INFISICAL_TOKEN=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=
INFISICAL_PATH=
INFISICAL_HOST=https://app.infisical.com
MONGODB_URI=mongodb://localhost:27017
MONGODB_URI_DOCKER=mongodb://mongo:27017
MONGODB_DATABASE=mongodb-ai-prod
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_NIM_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=60
# Jev is the active router when enabled. Set shadow mode true only for comparison.
JEV_ENABLED=false
JEV_SHADOW_MODE=false
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2500
JEV_MIN_CONFIDENCE=0.70
JEV_MAX_CALLS_PER_REQUEST=1
JEV_INPUT_COST_PER_MILLION_USD=0.042
JEV_OUTPUT_COST_PER_MILLION_USD=0
AUTH_JWT_ISSUER=https://ouros-keycloak.discloud.app/realms/ouros
AUTH_JWT_AUDIENCE=ms-ai-server
AUTH_JWKS_URL=https://ouros-keycloak.discloud.app/realms/ouros/protocol/openid-connect/certs
METRICS_KEYCLOAK_AUTHORIZED_PARTY=ouros-prometheus
MCP_URL=https://ms-midas-mcp.discloud.app/mcp/
MCP_TOOL_TIMEOUT_SECONDS=10
MCP_TOOLS_CACHE_TTL_SECONDS=300
# Optional override; defaults to AUTH_JWT_ISSUER + /protocol/openid-connect/token.
MCP_KEYCLOAK_TOKEN_EXCHANGE_URL=
MCP_KEYCLOAK_TOKEN_EXCHANGE_CLIENT_ID=ms-ai-server-mcp-exchange
MCP_KEYCLOAK_TOKEN_EXCHANGE_CLIENT_SECRET=
MCP_KEYCLOAK_TOKEN_EXCHANGE_AUDIENCE=ms-mcp-server-ouros-knowledge
TELEMETRY_KEYCLOAK_TOKEN_EXCHANGE_AUDIENCE=ms-telemetry-dashboard-service
MCP_KEYCLOAK_TOKEN_EXCHANGE_TIMEOUT_SECONDS=8

# Optional developer-only chat console. Keep disabled on ordinary deployments.
DEBUG_UI_ENABLED=false
# Optional override; defaults to AUTH_JWT_ISSUER + /protocol/openid-connect/token.
DEBUG_UI_KEYCLOAK_TOKEN_URL=
DEBUG_UI_KEYCLOAK_CLIENT_ID=ms-ai-server-debug
DEBUG_UI_KEYCLOAK_CLIENT_SECRET=
DEBUG_UI_COOKIE_SECURE=true
DEBUG_UI_REQUEST_TIMEOUT_SECONDS=8
